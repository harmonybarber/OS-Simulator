"""Integration tests verifying Process, Memory Manager, and FileSystem interaction."""
from engine.process import Process
from engine.filesystem import FileSystem
from engine.integration import run_integrated_simulation


def test_process_generated_memory_references():
    """Verify processes generate deterministic per-tick page references consumed by Memory Manager."""
    p1 = Process(pid="P1", arrival=0, burst=3, memory_pages=(10, 20, 10))
    p2 = Process(pid="P2", arrival=0, burst=2, memory_pages=(30, 10))

    result = run_integrated_simulation(
        processes=[p1, p2],
        algorithm="FCFS",
        frame_capacity=2,
        memory_policy="LRU",
        persist_system_logs=False,
    )

    refs = result["process"]["memory_references"]
    assert [(r["pid"], r["page"]) for r in refs] == [
        ("P1", 10),
        ("P1", 20),
        ("P1", 10),
        ("P2", 30),
        ("P2", 10),
    ]
    assert result["memory"]["total_references"] == 5
    assert result["memory"]["hits"] == 2
    assert result["memory"]["faults"] == 3


def test_authorized_and_unauthorized_process_file_requests():
    """Verify authorized file requests succeed while unauthorized requests are denied."""
    fs = FileSystem()
    fs.execute("mkdir", "/p1", pid="kernel")
    fs.execute("mkdir", "/shared", pid="kernel")
    fs.execute("mkfile", "/shared/readme.txt", pid="kernel")
    fs.execute("write", "/shared/readme.txt", content="hello", pid="kernel")

    p1 = Process(
        pid="P1",
        arrival=0,
        burst=2,
        file_requests=(
            {"at_tick": 1, "command": "mkfile", "path": "/p1/data.txt", "io_duration": 1},
            {"at_tick": 2, "command": "write", "path": "/p1/data.txt", "content": "secret", "io_duration": 1},
        ),
    )
    p2 = Process(
        pid="P2",
        arrival=1,
        burst=2,
        file_requests=(
            {"at_tick": 1, "command": "cat", "path": "/shared/readme.txt", "io_duration": 1},
            {"at_tick": 2, "command": "cat", "path": "/p1/data.txt", "io_duration": 1},
        ),
    )

    perms = {
        "P1": {"prefixes": ["/p1"], "read_only": False},
        "P2": {"prefixes": ["/shared"], "read_only": True},
    }

    result = run_integrated_simulation(
        processes=[p1, p2],
        algorithm="FCFS",
        filesystem=fs,
        permissions=perms,
        persist_system_logs=False,
    )

    file_events = result["process"]["file_events"]
    assert len(file_events) == 4
    assert file_events[0]["status"] == "AUTHORIZED"
    assert file_events[1]["status"] == "AUTHORIZED"
    assert file_events[2]["status"] == "AUTHORIZED"
    assert file_events[2]["result"] == "hello"
    assert file_events[3]["status"] == "DENIED"
    assert "not authorized" in file_events[3]["result"]
    assert fs.entries["/p1/data.txt"]["content"] == "secret"


def test_blocked_and_ready_process_behavior():
    """Verify a process blocks on authorized file I/O, yields the CPU, and returns to Ready."""
    fs = FileSystem()
    fs.execute("mkdir", "/work", pid="kernel")

    p1 = Process(
        pid="P1",
        arrival=0,
        burst=3,
        file_requests=(
            {"at_tick": 1, "command": "mkfile", "path": "/work/log.txt", "io_duration": 3},
        ),
    )
    p2 = Process(pid="P2", arrival=0, burst=2)

    result = run_integrated_simulation(
        processes=[p1, p2],
        algorithm="FCFS",
        filesystem=fs,
        permissions={"P1": {"prefixes": ["/work"], "read_only": False}},
        persist_system_logs=False,
    )

    p1_states = [e["state"] for e in result["process"]["events"] if e["pid"] == "P1"]
    assert p1_states == ["Ready", "Running", "Blocked", "Ready", "Running", "Terminated"]

    gantt = result["process"]["gantt"]
    assert gantt[0] == {"pid": "P1", "start": 0, "end": 1}
    assert gantt[1] == {"pid": "P2", "start": 1, "end": 3}
    assert gantt[2] == {"pid": "Idle", "start": 3, "end": 4}
    assert gantt[3] == {"pid": "P1", "start": 4, "end": 6}


def test_memory_and_filesystem_component_connection():
    """Verify Memory Manager telemetry is persisted into the FileSystem."""
    fs = FileSystem()
    p1 = Process(pid="P1", arrival=0, burst=4, memory_pages=(1, 2, 3, 1))

    run_integrated_simulation(
        processes=[p1],
        algorithm="FCFS",
        frame_capacity=2,
        memory_policy="FIFO",
        filesystem=fs,
        persist_system_logs=True,
    )

    assert "/sys/memory_report.txt" in fs.entries
    report = fs.execute("cat", "/sys/memory_report.txt", pid="kernel")
    assert "Policy: FIFO | Frames: 2" in report
    assert "Total References: 4" in report
    assert "Hits: 0 | Faults: 4" in report
    